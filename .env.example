# Feishu app credentials must only be used by a backend or serverless function.
# Do not expose these values in browser code.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Use FEISHU_BASE_APP_TOKEN for a normal /base URL, or FEISHU_WIKI_NODE_TOKEN
# for a /wiki URL. If both are set, FEISHU_BASE_APP_TOKEN wins.
FEISHU_BASE_APP_TOKEN=
FEISHU_WIKI_NODE_TOKEN=
FEISHU_BASE_TABLE_ID=
FEISHU_BASE_VIEW_ID=

# Optional cache controls for the backend data endpoint.
CARDS_CACHE_TTL_SECONDS=300
